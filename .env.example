POSTGRES_USER=askmemind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=askmemind

DATABASE_URL=postgresql+psycopg://askmemind:change-me@postgres:5432/askmemind
SECRET_KEY=change-me-to-a-long-random-secret
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=32
NVIDIA_API_KEY=
EMBEDDING_V2_ENABLED=False

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=500
GROQ_API_KEY=
HYBRID_SEARCH_ENABLED=False
RERANKER_ENABLED=False
RERANKER_CANDIDATE_K=20
RETRIEVAL_MIN_CONFIDENCE=0.05
CITATION_VALIDATION_ENABLED=True
AGENTIC_RETRIEVAL_ENABLED=False
AGENTIC_RETRIEVAL_MAX_RETRIES=1
AGENTIC_RETRIEVAL_MIN_CONFIDENCE=0.35

UPLOAD_DIR=storage/uploads
TEMP_DIR=storage/temp
MAX_UPLOAD_SIZE_MB=25
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Production browser sessions (host-only cookie; no Cookie Domain setting).
ENVIRONMENT=production
AUTH_REFRESH_COOKIE_NAME=__Host-askmemind_refresh
AUTH_REFRESH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_CSRF_TRUSTED_ORIGINS=https://askmemind.fullfact.xyz
# Explicit body-token endpoints for trusted CLI/native clients only.
AUTH_JSON_TOKENS_ENABLED=False
# For HTTP localhost instead, override ENVIRONMENT=local,
# AUTH_REFRESH_COOKIE_NAME=askmemind_refresh, AUTH_REFRESH_COOKIE_SECURE=False,
# and both origin lists with http://localhost:5173 (no trailing slash).
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_URL=https://your-frontend.example/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=False
BACKEND_CORS_ORIGINS=https://askmemind.fullfact.xyz
ENABLE_REGISTRATION=False
