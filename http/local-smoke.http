# Local smoke flow:
# 1. Register/login
# 2. Copy access_token into @accessToken
# 3. Create chat and copy id into @chatId
# 4. Upload PDF and copy id into @documentId
# 5. Ask RAG question
# 6. Verify chat messages include user + assistant messages

@baseUrl = http://127.0.0.1:8000
@chatId = replace-with-chat-id
@accessToken = replace-with-access-token
@documentId = replace-with-document-id
@question = What is this document about?

###
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "abc@example.com",
  "password": "password123"
}

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "abc@example.com",
  "password": "password123"
}

###
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

###
GET {{baseUrl}}/chats
Authorization: Bearer {{accessToken}}

###
POST {{baseUrl}}/chats
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Local Smoke Chat"
}

### List messages before RAG question
GET {{baseUrl}}/chats/{{chatId}}/messages
Authorization: Bearer {{accessToken}}

### Optional: create a plain user message without RAG
POST {{baseUrl}}/chats/{{chatId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "create message"
}

###
POST {{baseUrl}}/documents/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="file"; filename="test.pdf"
Content-Type: application/pdf

< ./test.pdf
--UploadBoundary--

###
GET {{baseUrl}}/documents
Authorization: Bearer {{accessToken}}

###
GET {{baseUrl}}/documents/{{documentId}}
Authorization: Bearer {{accessToken}}

###
POST {{baseUrl}}/chats/{{chatId}}/questions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "{{question}}",
  "document_id": "{{documentId}}",
  "top_k": 3
}

### Verify persisted RAG messages
GET {{baseUrl}}/chats/{{chatId}}/messages
Authorization: Bearer {{accessToken}}